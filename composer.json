{
    "name": "hakone/indexnow",
    "description": "An IndexNow client implementation based on PSR-17",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "php-http/discovery": "^1.15",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "kriswallsmith/buzz": "^1.2",
        "nyholm/psr7": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Hakone\\IndexNow\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hakone\\IndexNow\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
